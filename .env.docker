# FastRTC Docker Environment
# For Docker testing on Linux/macOS
# Usage: ./fastrtc.sh docker

# =============================================================================
# Docker Configuration
# =============================================================================

# External IP (auto-detected or set manually)
EXTERNAL_IP=localhost

# CoTURN Configuration
TURN_AUTH_SECRET=fastrtc-docker-secret-change-in-production
STUN_SERVERS=stun:localhost:3478
TURN_SERVERS=turn:localhost:3478

# =============================================================================
# Backend Configuration
# =============================================================================

# Environment
ENVIRONMENT=docker
DEBUG=false
LOG_LEVEL=INFO

# Conversation Display
SHOW_CONVERSATION=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Service URLs (Docker networking)
OLLAMA_URL=http://localhost:11434
OLLAMA_CONVERSATIONAL_MODEL=llama3:8b-instruct-q4_K_M
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=mistral-nemo-instruct-2407
REDIS_URL=redis://localhost:6379/0

# A-MEM Configuration
AMEM_LLM_MODEL=llama3.2:3b
AMEM_EMBEDDER_MODEL=all-MiniLM-L6-v2

# Audio Configuration
HF_MODEL_ID=openai/whisper-large-v3
STT_BACKEND=faster
WHISPER_MODEL=base

# WebRTC Configuration (Docker)
WEBRTC_MEDIA_PORT_FROM=31001
WEBRTC_MEDIA_PORT_TO=32000

# File Paths (Docker)
CHROMA_DB_PATH=/app/backend/chroma_db
MODELS_PATH=/app/backend/models
HF_HOME=/root/.cache/huggingface

# Timeout Configuration (seconds)
HTTP_TIMEOUT=30.0
LLM_TIMEOUT=15.0
STT_TIMEOUT=10.0
MEMORY_TIMEOUT=6.0
STARTUP_TIMEOUT=60.0
SHUTDOWN_TIMEOUT=20.0

# Security
ENABLE_CORS=true
CORS_ORIGINS=*
ENABLE_API_KEY=false
API_KEY=

# Monitoring
ENABLE_METRICS=false
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30.0

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8

# HuggingFace Configuration
HF_HUB_DOWNLOAD_TIMEOUT=3600
HF_HUB_ETAG_TIMEOUT=60

# =============================================================================
# Frontend Configuration
# =============================================================================

# API URLs (Docker networking)
FRONTEND_API_URL=http://localhost:8000
FRONTEND_WEBRTC_API_URL=http://localhost:8000/assistant/webrtc/offer
FRONTEND_WS_URL=ws://localhost:8000/ws

# WebRTC Configuration (Docker)
FRONTEND_STUN_SERVERS=stun:localhost:3478
FRONTEND_TURN_SERVERS=turn:localhost:3478

# Build-time environment variables for Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEBRTC_API_URL=http://localhost:8000/assistant/webrtc/offer
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_STUN_SERVERS=stun:localhost:3478
NEXT_PUBLIC_TURN_SERVERS=turn:localhost:3478
NEXT_PUBLIC_FALLBACK_STUN=stun:stun.l.google.com:19302

# Docker flags
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_ENVIRONMENT=docker
NEXT_PUBLIC_PLATFORM=docker