# FastRTC Development Environment
# For local development without Docker
# Usage: ./fastrtc.sh dev

# =============================================================================
# Backend Configuration
# =============================================================================

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Conversation Display
SHOW_CONVERSATION=true

# Debug Configuration - Enhanced Logging Control
DEBUG_TIMING=true
DEBUG_TTS=true
DEBUG_STREAMING=true
DEBUG_MEMORY=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Service URLs (local development)
OLLAMA_URL=http://localhost:11434
OLLAMA_CONVERSATIONAL_MODEL=llama3:8b-instruct-q4_K_M
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=mistral-nemo-instruct-2407
REDIS_URL=redis://localhost:6379/0

# A-MEM Configuration
AMEM_LLM_MODEL=llama3.2:3b
AMEM_EMBEDDER_MODEL=all-MiniLM-L6-v2

# Audio Configuration
HF_MODEL_ID=openai/whisper-large-v3
STT_BACKEND=faster
WHISPER_MODEL=base

# WebRTC Configuration (development - no external STUN/TURN needed)
EXTERNAL_IP=localhost
STUN_SERVERS=stun:stun.l.google.com:19302
TURN_SERVERS=
WEBRTC_MEDIA_PORT_FROM=31001
WEBRTC_MEDIA_PORT_TO=32000

# Timeout Configuration (seconds)
HTTP_TIMEOUT=20.0
LLM_TIMEOUT=10.0
STT_TIMEOUT=8.0
MEMORY_TIMEOUT=4.0
STARTUP_TIMEOUT=30.0
SHUTDOWN_TIMEOUT=15.0

# File Paths
CHROMA_DB_PATH=backend/chroma_db
MODELS_PATH=backend/models
LOG_FILE_PATH=./logs/voice_assistant.log
HF_HOME=~/.cache/huggingface

# Security
ENABLE_CORS=true
CORS_ORIGINS=*
ENABLE_API_KEY=false
API_KEY=

# Monitoring
ENABLE_METRICS=false
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30.0

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8

# =============================================================================
# Frontend Configuration
# =============================================================================

# API URLs (local development)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEBRTC_API_URL=http://localhost:8000/assistant/webrtc/offer
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# WebRTC Configuration (development)
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_SERVERS=
NEXT_PUBLIC_FALLBACK_STUN=stun:stun1.l.google.com:19302

# Development flags
NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_PLATFORM=development