# Auto-generated backend environment file for Windows
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Debug Configuration - Enhanced Logging Control
DEBUG_TIMING=false
DEBUG_TTS=false
DEBUG_STREAMING=false
DEBUG_MEMORY=false
SHOW_CONVERSATION=true

# Threading Pipeline Configuration
USE_THREADING_PIPELINE=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Service URLs
OLLAMA_URL=http://localhost:11434
OLLAMA_CONVERSATIONAL_MODEL=llama3:8b-instruct-q4_K_M
LM_STUDIO_URL=http://192.168.1.5:1234/v1
LM_STUDIO_MODEL=mistral-nemo-instruct-2407
REDIS_URL=redis://localhost:6379/0

# A-MEM Configuration
AMEM_LLM_MODEL=llama3.2:3b
AMEM_EMBEDDER_MODEL=all-MiniLM-L6-v2

# Audio Configuration
HF_MODEL_ID=openai/whisper-large-v3
STT_BACKEND=faster
WHISPER_MODEL=base

# WebRTC Configuration
EXTERNAL_IP=79.46.27.95
INTERNAL_IP=backend
STUN_SERVERS=stun:79.46.27.95:3478
TURN_SERVERS=turn:79.46.27.95:3478
TURN_AUTH_SECRET=your_static_auth_secret
WEBRTC_MEDIA_PORT_FROM=31001
WEBRTC_MEDIA_PORT_TO=32000

# File Paths
CHROMA_DB_PATH=backend/chroma_db
MODELS_PATH=backend/models
HF_HOME=/root/.cache/huggingface

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
