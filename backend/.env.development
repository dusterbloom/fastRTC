# FastRTC Voice Assistant Configuration Template
# Copy to .env.development, .env.testing, or .env.production

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG


# Debug Configuration - Enhanced Logging Control
DEBUG_TIMING=true
DEBUG_TTS=true
DEBUG_STREAMING=true
DEBUG_MEMORY=true
SHOW_CONVERSATION=true

# Server Configuration
HOST=0.0.0.0
PORT=7860

# Service URLs
OLLAMA_URL=http://localhost:11434
OLLAMA_CONVERSATIONAL_MODEL=gemma3:27b
LM_STUDIO_URL=http://192.168.1.5:1234/v1
LM_STUDIO_MODEL=mistral-nemo-instruct-2407


# A-MEM Configuration
AMEM_LLM_MODEL=llama3.2:3b
AMEM_EMBEDDER_MODEL=all-MiniLM-L6-v2

# Audio Configuration
HF_MODEL_ID=openai/whisper-large-v3
FASTER_WHISPER_MODEL_PATH=home\peppi\.cache\huggingface\hub\models--Systran--faster-whisper-base\snapshots\ebe41f70d5b6dfa9166e2c581c45c9c0cfc57b66

# Timeout Configuration (seconds)
HTTP_TIMEOUT=20.0
LLM_TIMEOUT=10.0
STT_TIMEOUT=8.0
MEMORY_TIMEOUT=4.0
STARTUP_TIMEOUT=30.0
SHUTDOWN_TIMEOUT=15.0

# File Paths
CHROMA_DB_PATH="backend/chroma_db"
MODELS_PATH="backend/models"
LOG_FILE_PATH=./logs/voice_assistant.log

# Security
ENABLE_CORS=true
CORS_ORIGINS=*
ENABLE_API_KEY=false
API_KEY=

# Monitoring
ENABLE_METRICS=false
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30.0

# Threading Pipeline Configuration
USE_THREADING_PIPELINE=true
THREADING_FALLBACK_TO_ASYNC=true
THREADING_MAX_QUEUE_SIZE=100
THREADING_PROCESSING_TIMEOUT=0.1
THREADING_GENERATION_TIMEOUT=30.0
THREADING_CLEANUP_INTERVAL=10.0
THREADING_STT_CONFIDENCE=0.6
THREADING_STT_MIN_AUDIO=0.5
THREADING_LLM_MIN_SENTENCE=10
THREADING_TTS_CHUNK_SIZE=1024
THREADING_OUTPUT_TIMEOUT=0.05