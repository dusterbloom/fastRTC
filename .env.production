# FastRTC Production Environment
# For production deployment with Docker
# Usage: EXTERNAL_IP=your.server.ip ./fastrtc.sh prod

# =============================================================================
# Production Configuration - REQUIRED SETTINGS
# =============================================================================

# External server IP - REQUIRED (auto-detected if not set)
# Set this to your server's public IP address
EXTERNAL_IP=auto

# TURN authentication secret - REQUIRED
# Generate with: openssl rand -hex 16
# Keep this secret secure!
TURN_AUTH_SECRET=your_static_auth_secret

# SSL certificate paths for TURNS (recommended for production)
SSL_CERT_PATH=/etc/ssl/certs/fastrtc_cert.pem
SSL_KEY_PATH=/etc/ssl/private/fastrtc_key.pem

# =============================================================================
# Backend Configuration
# =============================================================================

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Conversation Display
SHOW_CONVERSATION=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Service URLs (production)
OLLAMA_URL=http://localhost:11434
OLLAMA_CONVERSATIONAL_MODEL=llama3:8b-instruct-q4_K_M
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=mistral-nemo-instruct-2407
REDIS_URL=redis://localhost:6379/0

# A-MEM Configuration
AMEM_LLM_MODEL=llama3.2:3b
AMEM_EMBEDDER_MODEL=all-MiniLM-L6-v2

# Audio Configuration
HF_MODEL_ID=openai/whisper-large-v3
STT_BACKEND=faster
WHISPER_MODEL=base

# WebRTC Configuration (production)
WEBRTC_MEDIA_PORT_FROM=31001
WEBRTC_MEDIA_PORT_TO=32000

# File Paths (production Docker)
CHROMA_DB_PATH=/app/backend/chroma_db
MODELS_PATH=/app/backend/models
HF_HOME=/root/.cache/huggingface

# Timeout Configuration (production - more conservative)
HTTP_TIMEOUT=45.0
LLM_TIMEOUT=20.0
STT_TIMEOUT=15.0
MEMORY_TIMEOUT=8.0
STARTUP_TIMEOUT=120.0
SHUTDOWN_TIMEOUT=30.0

# Security (production)
ENABLE_CORS=true
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ENABLE_API_KEY=true
API_KEY=your-secure-api-key-change-this

# Monitoring (production)
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=60.0

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8

# HuggingFace Configuration
HF_HUB_DOWNLOAD_TIMEOUT=7200
HF_HUB_ETAG_TIMEOUT=120

# =============================================================================
# Frontend Configuration (Production)
# =============================================================================

# Note: EXTERNAL_IP will be automatically substituted in Docker Compose

# Build-time environment variables for Next.js
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_PLATFORM=production
NEXT_PUBLIC_DEBUG=false

# Production security
NEXT_PUBLIC_API_KEY_REQUIRED=true